<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fielding.mouse-tap</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/libexec/mouseless/mouse-tap.app/Contents/MacOS/mouse-tap</string>
    <string>--out</string>
    <string>__HOME__/.local/share/mouseless/mouse.jsonl</string>
    <string>--heartbeat</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Retry until Input Monitoring is granted (tapCreate fails -> exit 2). -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__HOME__/.local/share/mouseless/mouse-tap.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/share/mouseless/mouse-tap.err.log</string>
</dict>
</plist>
