**/extra.*
git/.git-templates/hooks/*.sample
karabiner/.config/karabiner/assets
terminfo/.terminfo/69/iterm.app
terminfo/.terminfo/69/iterm
terminfo/.terminfo/74/tmux
terminfo/.terminfo/74/tmux-256color
vim/.vim/autoload/*
vim/.vim/files/backup/*
vim/.vim/files/swap/*
vim/.vim/files/undo/*
vim/.vim/plugged/*
vim/.vim/.netrwhist
tmux/.tmux/resurrect
tmux/.tmux/plugins/*

# macOS app bundles
*.app/

# Compiled binaries (keep scripts only)
bin/bin/box

# Repo-local Claude Code settings (not stow-managed)
/.claude/

# Local issue tracker
.tix/

# Auto-generated sketchybar helpers (duplicate of icon_map.sh)
sketchybar/.config/sketchybar/helpers/

# Symlinks to local builds
bin/bin/do
bin/bin/hold
bin/bin/iter
bin/bin/mon
bin/bin/tix
bin/bin/vent
bin/bin/warm
bin/bin/zed
.handoff
.handoff/

# Karabiner app-generated config backups
karabiner/.config/karabiner/automatic_backups/

# Python bytecode caches (tests, py_compile)
__pycache__/

# ~/.claude and ~/.codex are stow-folded into this repo, so Claude Code and
# Codex write their runtime state (sessions, caches, credentials, logs) next
# to the config. Track only the config files.
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/themes/
!claude/.claude/hooks/
codex/.codex/*
!codex/.codex/config.toml
!codex/.codex/hooks.json
!codex/.codex/herdr-agent-state.sh
