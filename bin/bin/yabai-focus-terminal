#!/usr/bin/env bash
# yabai-focus-terminal — ensure a terminal is focused on the CURRENT space.
#
# If the focused window is already a terminal, do nothing. Otherwise focus a
# terminal window on the current space (preferring one that already has focus
# hint, else the first). Never switches spaces; no-op if no terminal is here.
#
# Used by skhd tmux-mode activation so popups/prompts land on the terminal
# instead of whatever window happened to be focused.

set -euo pipefail

is_term='.app=="Ghostty" or .app=="Terminal" or .app=="iTerm2" or .app=="kitty" or .app=="Alacritty" or .app=="WezTerm"'

focused=$(yabai -m query --windows --window 2>/dev/null \
  | jq -r "if ($is_term) then \"yes\" else \"no\" end" 2>/dev/null || echo no)
[ "$focused" = "yes" ] && exit 0

wid=$(yabai -m query --windows --space 2>/dev/null \
  | jq -r "[.[] | select($is_term)] | (map(select(.\"has-focus\"==true))[0] // .[0]) | .id // empty" \
  2>/dev/null || true)

[ -n "$wid" ] && yabai -m window --focus "$wid" 2>/dev/null || true
